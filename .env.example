# ---- LLM provider (any OpenAI-compatible /chat/completions endpoint) ----
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=replace-me            # leave empty for local servers (vLLM, Ollama, LM Studio) that need no key
LLM_MODEL_NAME=gpt-4o-mini
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_RETRY_BACKOFF_SECONDS=1.0

# ---- Embeddings (required model: intfloat/e5-large-v2) ----
EMBEDDING_MODEL_NAME=intfloat/e5-large-v2
EMBEDDING_MODEL_PATH=             # optional: local dir of a pre-downloaded copy (skips the Hugging Face download)
EMBEDDING_BATCH_SIZE=16

# ---- RAG ----
DOCUMENTS_DIR=data/documents
INDEX_DIR=data/index
CHUNK_SIZE=700
CHUNK_OVERLAP=120
RAG_TOP_K=4
# e5 cosine scores cluster high (~0.7-0.9). 0.80 is an UNCALIBRATED starting value - tune on your corpus.
RAG_MIN_SIMILARITY=0.80

# ---- Database ----
SQLITE_PATH=data/acme.db
SQL_MAX_ROWS=200
SQL_TIMEOUT_SECONDS=5
SQL_REPAIR_ATTEMPTS=1

# ---- Coordinator / API ----
MAX_PLAN_STEPS=4
MAX_TOOL_CALLS=4
REQUEST_TIMEOUT_SECONDS=90
LOG_LEVEL=INFO
